/* ─────────────────────────────────────────────────────────────
   YouVideo Downloader – Modern Dark Theme (2025)
   Fixes all overlap, clipping, and layout issues
   ───────────────────────────────────────────────────────────── */

QMainWindow, QWidget#centralWidget {
    background-color: #0f0f0f;
    color: #e0e0e0;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
}

/* ──────────────── Base Widgets ──────────────── */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #23242a, stop:1 #1a1b1f);
    color: #ffffff;
    border: 2px solid #2a2b30;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 15px;
    min-height: 20px;
}

QPushButton:hover {
    background: #2a2b30;
    border-color: #ff5e62;
    color: #ff5e62;
}

QPushButton:pressed {
    background: #18191c;
    border-color: #ff0000;
    color: #ff0000;
}

QPushButton:disabled {
    background: #18181c;
    color: #555555;
    border-color: #2a2a2a;
}

/* Special Download Button – BIG GREEN */
QPushButton#downloadButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #27ae60, stop:1 #2ecc71);
    color: white;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 10px;
    padding: 14px 30px;
}

QPushButton#downloadButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #229954, stop:1 #27ae60);
}

QPushButton#downloadButton:disabled {
    background: #95a5a6;
}

/* ──────────────── Input Fields ──────────────── */
QLineEdit, QComboBox, QTextEdit {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #191a1d, stop:1 #23242a);
    color: #ffffff;
    border: 2px solid #2a2b30;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 15px;
    selection-background-color: #ff5e62;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #ff5e62;
}

/* ComboBox Dropdown Arrow */
QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(:/icons/down-arrow.png); /* optional custom arrow */
    width: 12px;
    height: 12px;
}

/* ──────────────── Labels ──────────────── */
QLabel {
    color: #e0e0e0;
    font-size: 15px;
    background: transparent;
}

QLabel#headerLabel {
    font-size: 26px;
    font-weight: bold;
    color: #ff5e62;
    padding: 10px;
    background: transparent;
}

/* ──────────────── Video List ──────────────── */
QListWidget {
    background-color: #141518;
    border: 2px solid #2a2b30;
    border-radius: 12px;
    alternate-background-color: #191a1e;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    padding: 10px 8px;
    border-bottom: 1px solid #222327;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ff5e62, stop:1 #e91e63);
    color: white;
    border-radius: 8px;
}

QListWidget::item:hover:!selected {
    background: #2a2b30;
    border-radius: 8px;
}

/* ──────────────── Progress Bar ──────────────── */
QProgressBar {
    border: 2px solid #2a2b30;
    border-radius: 12px;
    background-color: #141518;
    text-align: center;
    font-weight: bold;
    font-size: 14px;
    height: 28px;
    color: white;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ff5e62, stop:1 #ff1744);
    border-radius: 10px;
    margin: 2px;
}

/* ──────────────── Frames & Panels ──────────────── */
QFrame {
    background: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] { /* StyledPanel */
    background: rgba(35, 36, 42, 0.4);
    border: 1px solid #2a2b30;
    border-radius: 12px;
    padding: 10px;
    margin: 4px;
}

/* ──────────────── Scrollbars (Optional Polish) ──────────────── */
QScrollBar:vertical {
    background: #141518;
    width: 12px;
    border-radius: 6px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #2a2b30;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #ff5e62;
}

QFrame#urlCard {
    background: rgba(40, 42, 50, 0.5);
    border: 2px solid #353740;
    border-radius: 18px;
}

QLabel#headerLabel {
    font-size: bold 32px;
    color: #ff5e62;
    padding: 10px;
}