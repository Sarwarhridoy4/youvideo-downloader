/*
    welcome_light.qss - YouTube-Inspired Light Theme for Welcome Screen
    
    Color Palette:
    - Background: #ffffff (White) - inverted from #0f0f0f
    - Surface: #f8f9fa (Light Gray) - inverted from #212121
    - Primary: #ff0000 (YouTube Red) - same
    - Secondary: #3ea6ff (YouTube Blue) - same
    - Text: #0f0f0f (Primary Text) - inverted from #ffffff
    - Text Secondary: #606060 (Secondary Text) - inverted from #aaaaaa
*/

QWidget {
    background: #ffffff;
    color: #0f0f0f;
    font-family: 'Roboto', 'Segoe UI', sans-serif;
    border-radius: 22px;
}

QLabel#title {
    color: #0f0f0f;
    font-size: 30px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 18px 0 8px 0;
    qproperty-alignment: 'AlignCenter';
}

QLabel#subtitle {
    color: #606060;
    font-size: 16px;
    margin-bottom: 22px;
    qproperty-alignment: 'AlignCenter';
}

QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff0000, stop:1 #cc0000);
    color: #ffffff;
    font-size: 18px;
    border: none;
    border-radius: 18px;
    padding: 14px 40px;
    margin-top: 22px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff1a1a, stop:1 #e60000);
    border: 2px solid #ff0000;
}

QPushButton:pressed {
    background-color: #cc0000;
    border: 2px solid #990000;
}

QPushButton:disabled {
    background-color: #e8eaed;
    color: #9e9e9e;
    border: none;
}

/* Secondary Button Style (if needed) */
QPushButton#secondary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3ea6ff, stop:1 #2a8dd6);
    border: none;
}

QPushButton#secondary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #65b8ff, stop:1 #3ea6ff);
    border: 2px solid #3ea6ff;
}

QPushButton#secondary:pressed {
    background-color: #2a8dd6;
    border: 2px solid #1976d2;
}

/* Theme Toggle Button - Same position, inverted colors */
QPushButton#themeToggle {
    background-color: rgba(248, 249, 250, 0.95);
    border: 1px solid #dadce0;
    border-radius: 20px;
    padding: 8px 12px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    font-size: 16px;
    margin: 0;
    text-transform: none;
    letter-spacing: 0;
}

QPushButton#themeToggle:hover {
    background-color: rgba(241, 243, 244, 1);
    border-color: #ff0000;
    box-shadow: 0 4px 12px rgba(255, 0, 0, 0.15);
}

/* Credits Label */
#credit_label {
    font-size: 14px;
    color: #606060;
    margin-top: 2rem;
    margin-bottom: 2rem;
}

#credit_label:hover {
    color: #0f0f0f;
}

#credit_label a {
    color: #3ea6ff;
    text-decoration: none;
    font-weight: 500;
}

#credit_label a:hover {
    color: #65b8ff;
    text-decoration: underline;
}

/* Optional: Icon styling if you use QLabel for icons */
QLabel#icon {
    background-color: transparent;
    border-radius: 50%;
    padding: 12px;
}

/* Optional: Card/Container styling */
QFrame#card {
    background-color: #f8f9fa;
    border-radius: 16px;
    border: 1px solid #dadce0;
}

QFrame#card:hover {
    border: 1px solid #3ea6ff;
}

/* Optional: Divider/Separator */
QFrame#divider {
    background-color: #dadce0;
    max-height: 1px;
    border: none;
}

/* Optional: Input fields if needed */
QLineEdit {
    background-color: #f8f9fa;
    color: #0f0f0f;
    border: 2px solid #dadce0;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 2px solid #3ea6ff;
    background-color: #ffffff;
}

QLineEdit::placeholder {
    color: #9e9e9e;
}

/* Optional: Tooltip styling */
QToolTip {
    background-color: #f8f9fa;
    color: #0f0f0f;
    border: 1px solid #dadce0;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Optional: Selection styling */
*::selection {
    background-color: #3ea6ff;
    color: #ffffff;
}

/* Optional: Scrollbar styling (YouTube-like) */
QScrollBar:vertical {
    background-color: #ffffff;
    width: 12px;
    border-radius: 8px;
}

QScrollBar::handle:vertical {
    background-color: #c1c1c1;
    border-radius: 8px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #909090;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #ffffff;
    height: 12px;
    border-radius: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #c1c1c1;
    border-radius: 8px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #909090;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}