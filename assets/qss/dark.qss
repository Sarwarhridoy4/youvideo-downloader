/* ─────────────────────────────────────────────────────────────
   YouVideo Downloader – YouTube Official Dark Theme 2025
   Perfect pixel match with YouTube web/app dark mode
   Fully commented & ready for production
   ───────────────────────────────────────────────────────────── */

QMainWindow, QWidget#centralWidget {
    background-color: #0f0f0f;       /* YouTube's exact dark background */
    color: #f1f1f1;                  /* Primary text color */
    font-family: "Roboto", "YouTube Sans", "Segoe UI", sans-serif;
    font-size: 14px;
}

/* ────────────────────── Default Buttons ────────────────────── */
QPushButton {
    background-color: #262626;       /* Slightly elevated surface */
    color: #ffffff;
    border: 1px solid #303030;
    border-radius: 20px;             /* YouTube loves super-rounded buttons */
    padding: 10px 24px;
    font-weight: 500;                /* Medium weight – modern YouTube style */
    min-height: 20px;
}

QPushButton:hover {
    background-color: #383838;
    border-color: #ff0000;           /* Red accent on hover */
}

QPushButton:pressed {
    background-color: #1f1f1f;
}

QPushButton:disabled {
    background-color: #1a1a1a;
    color: #666666;
    border-color: #333333;
}

/* ───────────────── Primary Action Button (Download / Subscribe) ───────────────── */
QPushButton#downloadButton,
QPushButton#subscribeButton,
QPushButton[accessibleName="primary"] {
    background-color: #ff0000;       /* Official YouTube red */
    color: #ffffff;
    border: none;
    border-radius: 20px;
    padding: 13px 36px;
    font-weight: 600;
    font-size: 15px;
}

QPushButton#downloadButton:hover,
QPushButton#subscribeButton:hover {
    background-color: #cc0000;       /* Darker red on hover */
    box-shadow: 0 4px 16px rgba(255, 0, 0, 0.4);
}

QPushButton#downloadButton:disabled {
    background-color: #660000;
    color: #990000;
}

/* ────────────────────── Input Fields ────────────────────── */
QLineEdit, QComboBox, QTextEdit {
    background-color: #1f1f1f;
    color: #ffffff;
    border: 1px solid #303030;
    border-radius: 20px;
    padding: 12px 18px;
    font-size: 15px;
    selection-background-color: #ff3333;   /* Red selection */
}

QLineEdit:focus, QComboBox:focus {
    border-color: #ff0000;
    box-shadow: 0 0 0 3px rgba(255, 0, 0, 0.25);   /* YouTube-style focus ring */
    outline: none;
}

/* Special styling for URL/search bar – matches YouTube's search exactly */
QLineEdit#urlInput,
QLineEdit#searchInput {
    padding-left: 52px;              /* Space for magnifying glass icon */
    border-radius: 24px;
    font-size: 16px;
    background-color: #1f1f1f;
}

/* ────────────────────── Labels & Text ────────────────────── */
QLabel {
    color: #e0e0e0;
    background: transparent;
}

QLabel#headerLabel,
QLabel#titleLabel {
    font-size: 26px;
    font-weight: bold;
    color: #ffffff;
    padding: 8px 0;
}

QLabel#channelName {
    color: #aaaaaa;
    font-size: 15px;
    font-weight: 500;
}

QLabel#videoTitle {
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
}

QLabel#videoMeta {
    font-size: 13px;
    color: #909090;
}

/* ────────────────────── Video List / Results ────────────────────── */
QListWidget, QTreeWidget {
    background-color: #0f0f0f;
    border: none;
    outline: none;
    padding: 8px;
}

QListWidget::item {
    padding: 12px 10px;
    margin: 3px 0;
    border-radius: 12px;
}

QListWidget::item:hover {
    background-color: #262626;
}

QListWidget::item:selected {
    background-color: #ff0000;
    color: #ffffff;
    border-radius: 12px;
}

/* ────────────────────── Progress Bar ────────────────────── */
QProgressBar {
    border: none;
    background-color: #262626;
    border-radius: 8px;
    height: 8px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #ff0000;
    border-radius: 8px;
}

/* ────────────────────── Cards & Containers ────────────────────── */
QFrame#videoCard,
QGroupBox {
    background-color: #1f1f1f;
    border: 1px solid #303030;
    border-radius: 16px;
    padding: 16px;
    margin: 8px;
}

/* Thumbnail placeholder */
QLabel#thumbnail {
    background-color: #000000;
    border-radius: 12px;
    min-width: 220px;
    min-height: 124px;
    border: 1px solid #333;
}

/* ────────────────────── Scrollbars (YouTube style) ────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #444444;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #ff0000;             /* Red on hover – pure YouTube */
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;                     /* Hide arrows */
}

/* ────────────────────── Tooltips ────────────────────── */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
}

/* ────────────────────── Global Selection Color ────────────────────── */
* {
    selection-background-color: rgba(255, 0, 0, 0.4);
}

/* ────────────────────── Radio Buttons – Works perfectly in Light & Dark ────────────────────── */


QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #80868b;
    background-color: transparent;
}

QRadioButton::indicator:checked {
    border: 5px solid #ff0000;   /* red ring */
    background-color: #ffffff;   /* white dot */
}

QRadioButton::indicator:hover {
    border-color: #ff0000;
}

QRadioButton:disabled,
QRadioButton::indicator:disabled {
    color: #888888;
    border-color: #666666;
}