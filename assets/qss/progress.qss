/* ──────────────── QProgressDialog – YouTube Dark Style 2025 (Enhanced) ──────────────── */
QProgressDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1c1c1c, stop:1 #0f0f0f); /* Closer to current YouTube dark surfaces */
    color: #f1f1f1;
    border: 1px solid #303030;
    border-radius: 20px;
    min-width: 460px;
    max-width: 560px;
    padding: 20px;
    font-family: 'Roboto', 'Segoe UI', sans-serif;
    
    /* Subtle elevation */
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
}

/* Labels */
QProgressDialog QLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: 500;
    background: transparent;
    padding: 8px 0;
    margin: 0;
}

/* Title text */
QProgressDialog #qt_msgbox_label,
QProgressDialog #qt_title_label {
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
}

/* Progress Bar inside QProgressDialog */
QProgressDialog QProgressBar {
    background-color: #262626;
    border: 1px solid #303030;
    border-radius: 16px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 15px;
    height: 36px;
    min-height: 36px;
    
    transition: border-color 0.25s ease;
}

QProgressDialog QProgressBar:hover {
    border-color: #ff0000;
}

QProgressDialog QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ff0000, stop:1 #cc0000);
    border-radius: 14px;
    margin: 4px;
    
    transition: width 0.4s cubic-bezier(0.65, 0, 0.35, 1);
}

/* Indeterminate animation – smoother flowing bar */
QProgressDialog QProgressBar:indeterminate::chunk {
    background: qlineargradient(x1:0, y1:0, x2:2, y2:0,
                                stop:0 rgba(255,0,0,0),
                                stop:0.4 #ff3333,
                                stop:0.5 #ff0000,
                                stop:0.6 #ff3333,
                                stop:1 rgba(255,0,0,0));
    animation: indeterminateFlow 2s linear infinite;
}

@keyframes indeterminateFlow {
    0%   { background-position: -200px 0; }
    100% { background-position: 400px 0; }
}

/* Cancel button */
QProgressDialog QPushButton {
    background-color: #262626;
    color: #ff0000;
    border: 2px solid #ff0000;
    border-radius: 20px;
    padding: 10px 28px;
    font-weight: 600;
    min-width: 110px;
    font-size: 14px;
    
    transition: all 0.25s ease;
}

QProgressDialog QPushButton:hover {
    background-color: #ff0000;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(255, 0, 0, 0.4);
}

QProgressDialog QPushButton:pressed {
    background-color: #cc0000;
    transform: translateY(1px);
}

QProgressDialog QPushButton:disabled {
    background-color: #1a1a1a;
    color: #666666;
    border-color: #333333;
}

/* ──────────────── Standalone QProgressBar – YouTube Style 2025 (Enhanced) ──────────────── */
QProgressBar {
    background-color: #262626;
    border: 1px solid #303030;
    border-radius: 16px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    height: 32px;
    min-height: 32px;
    font-family: 'Roboto', 'Segoe UI', sans-serif;
    
    transition: border-color 0.25s ease;
}

QProgressBar:hover {
    border-color: #ff0000;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ff0000, stop:1 #cc0000);
    border-radius: 14px;
    margin: 3px;
    
    transition: width 0.4s cubic-bezier(0.65, 0, 0.35, 1);
}

/* Thin variant (like YouTube player bar) – subtle gray when idle */
QProgressBar#thin {
    height: 5px;
    min-height: 5px;
    border: none;
    border-radius: 3px;
    background-color: #3d3d3d;
}

QProgressBar#thin::chunk {
    background: #aaaaaa; /* Subtle light gray like modern YouTube passive state */
    border-radius: 3px;
}

QProgressBar#thin:hover::chunk,
QProgressBar#thin:focus::chunk {
    background: #ff0000; /* Turns red on interaction */
    height: 7px;
}

/* Indeterminate flowing animation */
QProgressBar:indeterminate::chunk {
    background: qlineargradient(x1:0, y1:0, x2:2, y2:0,
                                stop:0 rgba(255,0,0,0),
                                stop:0.4 #ff3333,
                                stop:0.5 #ff0000,
                                stop:0.6 #ff3333,
                                stop:1 rgba(255,0,0,0));
    animation: indeterminateFlow 2s linear infinite;
}

/* State variants */
QProgressBar#success::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00c853, stop:1 #00a843); }
QProgressBar#warning::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ffc107, stop:1 #ffb300); }
QProgressBar#error::chunk   { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff0000, stop:1 #d32f2f); }

/* Secondary blue variant */
QProgressBar#secondary::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3ea6ff, stop:1 #2a8dd6);
}